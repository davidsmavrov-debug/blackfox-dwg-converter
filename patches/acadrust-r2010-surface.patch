+// Some R2010 AcDbSurface records have a complete inline SAB body followed by
+// a compact surface trailer rather than the shared solid metadata fields.
+fn read_r2010_generic_surface_body(
+    reader: &mut DwgMergedReader,
+    mut original: DwgMergedReader,
+) -> Option<SurfaceEntityData> {
+    let empty = original.read_bit();
+    let _reserved = original.read_bit();
+    let version = original.read_bit_short();
+    if empty || version != 2 || original.has_error() {
+        return None;
+    }
+    let available = original.main_remaining_bits();
+    let data = original.clone().read_bytes(original.remaining_bytes());
+    let (model, consumed) = crate::entities::acis::SabReader::read_with_consumed(&data).ok()?;
+    let trailer_bits = available.checked_sub(consumed as i64 * 8)?;
+    if model.faces().is_empty() || trailer_bits != 23 {
+        return None;
+    }
+    let end = original.position_in_bits() + available;
+    original.set_position_in_bits(original.position_in_bits() + consumed as i64 * 8);
+    if original.read_bit() || !original.read_bit() || original.read_bit() {
+        return None;
+    }
+    let u_isolines = original.read_bit_short();
+    let v_isolines = original.read_bit_short();
+    if !(0..=512).contains(&u_isolines)
+        || !(0..=512).contains(&v_isolines)
+        || original.has_error()
+        || original.position_in_bits() != end
+    {
+        return None;
+    }
+    original.set_position_in_bits(end);
+    *reader = original;
+    let mut acis = empty_acis_entity();
+    acis.acis_empty = false;
+    acis.is_binary = true;
+    acis.version = version;
+    acis.sab_data = data[..consumed].to_vec();
+    Some(SurfaceEntityData {
+        acis,
+        modeler_format_version: 1,
+        u_isolines,
+        v_isolines,
+        surface_data: SurfaceData::Generic,
+        history_handle: 0,
+    })
+}
